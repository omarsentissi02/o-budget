{
  "name": "o-budget",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply o-budget --local",
    "db:migrate:remote": "wrangler d1 migrations apply o-budget --remote",
    "deploy": "npm run build && wrangler deploy",
    "reset-password": "node scripts/reset-password.mjs",
    "test:api": "node scripts/api-scenarios.mjs",
    "icons": "python3 scripts/generate-icons.py"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@tanstack/react-query": "^5.90.0",
    "hono": "^4.9.0",
    "lucide-react": "^1.51.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/workers-types": "^5.20261001.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.40.0"
  }
}
