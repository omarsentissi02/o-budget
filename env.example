# Variables locales pour `npm run dev` : copiez ce fichier en `.dev.vars` (ne le versionnez JAMAIS).
# En production, utilisez `wrangler secret put` pour les secrets (voir docs/environment.md).

# "false" ferme les inscriptions une fois votre compte créé.
ALLOW_SIGNUP=true

# --- Assistant IA (facultatif) : sans ces variables, l'assistant conversationnel affiche « non configuré ». ---
# anthropic | openai | openai-compatible
# AI_PROVIDER=anthropic
# Identifiant du modèle chez votre fournisseur (aucun nom n'est supposé par l'application).
# AI_MODEL=
# SECRET : n'est lu que par le Worker, jamais renvoyé au navigateur.
# AI_API_KEY=
# Uniquement pour openai-compatible (HTTPS obligatoire), ex. https://exemple.fr/v1
# AI_BASE_URL=
